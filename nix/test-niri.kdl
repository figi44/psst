// Two layouts, so tests can switch with `niri msg action switch-layout`.
input {
    keyboard {
        xkb {
            layout "us,cz"
            variant ",qwerty"
        }
    }
}

layout {
    // Flat, so a screenshot shows the overlay pill clearly.
    background-color "#4a6fa5"
}

hotkey-overlay {
    skip-at-startup
}

xwayland-satellite {
    off
}

animations {
    off
}

screenshot-path null

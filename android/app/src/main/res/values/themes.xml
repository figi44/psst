<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Psst" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackgroundFloating">@color/surface</item>
        <item name="android:colorPrimary">@color/bg</item>
        <!-- Carets, handles and switches: white, as red would read as an error. -->
        <item name="android:colorAccent">@color/fg</item>
        <item name="android:colorControlNormal">@color/muted</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:colorError">@color/danger</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textColorHighlight">@color/highlight</item>
        <!-- The overlay's Inter Medium (crates/psst-overlay/fonts, SIL OFL 1.1) in every weight,
             cut to 123 of its 417 KB: pyftsubset with Google Fonts' latin and latin-ext ranges,
             no hinting, and name IDs 0 to 14, which keep its copyright and license. -->
        <item name="android:fontFamily">@font/inter_medium</item>
    </style>
</resources>

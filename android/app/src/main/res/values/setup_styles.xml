<?xml version="1.0" encoding="utf-8"?>
<!-- The setup screen: an 8 dp grid, one accent, and the type scale 28/18/16/14 sp. -->
<resources>
    <style name="Setup.Display" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">28sp</item>
        <item name="android:lineHeight">36sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="Setup.Lead" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">24sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="Setup.Card" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/setup_card</item>
    </style>

    <style name="Setup.Header" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- A number to do, a check when done. -->
    <style name="Setup.Mark" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:gravity">center</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">6sp</item>
        <item name="android:autoSizeMaxTextSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/setup_step_text</item>
        <item name="android:background">@drawable/setup_step</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Setup.Title" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:lineHeight">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="Setup.Body" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="Setup.Label" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/fg</item>
    </style>

    <style name="Setup.Field" parent="@android:style/Widget.Material.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:background">@drawable/setup_field</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textColorHint">@color/setup_field</item>
    </style>

    <style name="Setup.Button" parent="@android:style/Widget.Material.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:background">@drawable/setup_button_secondary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/fg</item>
    </style>

    <style name="Setup.Button.Primary">
        <item name="android:background">@drawable/setup_button_primary</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- Primary while activated: while the step it belongs to is not done. -->
    <style name="Setup.Button.Step">
        <item name="android:background">@drawable/setup_button_step</item>
        <item name="android:textColor">@color/setup_button_step_text</item>
    </style>
</resources>

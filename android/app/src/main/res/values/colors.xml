<?xml version="1.0" encoding="utf-8"?>
<!-- The desktop overlay's palette (crates/psst-overlay). Each grey is fg at a fixed alpha over bg,
     flattened, so that it is the same grey on any surface. -->
<resources>
    <color name="bg">#000000</color>
    <color name="fg">#f5f5f7</color>
    <!-- 62% -->
    <color name="muted">#989899</color>
    <!-- 40% -->
    <color name="faint">#626263</color>
    <!-- 5%: cards -->
    <color name="surface">#0c0c0d</color>
    <!-- 7%: wells -->
    <color name="well">#111111</color>
    <!-- 10%: hairlines, fields, selected rows, secondary buttons -->
    <color name="line">#191919</color>
    <!-- 16% -->
    <color name="line_strong">#272728</color>
    <!-- The overlay's recording dot: the one accent, for recording and the mark that matters most. -->
    <color name="accent">#ff453a</color>
    <color name="ok">#3dd68c</color>
    <color name="warn">#ffb03b</color>
    <color name="danger">#ff5f52</color>

    <color name="ripple">#1ff5f5f7</color>
    <!-- On fg: a primary button. -->
    <color name="ripple_dark">#1f000000</color>
    <color name="highlight">#40f5f5f7</color>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- Focus and windows are all the bubble follows: where the keyboard is, and the field it serves. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewFocused|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/bubble_description"
    android:notificationTimeout="100"
    android:settingsActivity="io.github.figi44.psst.SetupActivity" />
